---
import { route, ui, type Locale } from '../lib/i18n';
import { SITE } from '../lib/site';

interface Props {
  locale: Locale;
  /** URL équivalente dans l'autre langue */
  altHref: string;
}
const { locale, altHref } = Astro.props;
const t = ui[locale];
const other = locale === 'en' ? 'fr' : 'en';
---

<div class="wrapper-legals">
  <a href={route('legal', locale)} class="nav-link" data-label={t.legals}>{t.legals}</a>
  <a href={altHref} class="nav-link" hreflang={other} lang={other} data-label={t.switchTo}>{t.switchTo}</a>
  <a href={SITE.cvUrl} target="_blank" rel="noopener" class="nav-link" data-label={t.cv}>{t.cv}</a>
</div>

<script>
  // mémorise le choix explicite de langue : il prime ensuite sur la langue du navigateur
  document.querySelectorAll<HTMLAnchorElement>('a[hreflang]').forEach((a) => {
    a.addEventListener('click', () => {
      try { localStorage.setItem('lang-pref', a.getAttribute('hreflang') ?? ''); } catch {}
    });
  });
</script>
