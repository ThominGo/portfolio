---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import { projectsByCategory } from '../lib/content';
import { meta, route, ui, workPath, type Locale } from '../lib/i18n';
import { SITE } from '../lib/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui[locale];
const m = meta[locale].home;
const threeD = projectsByCategory('3d-immersif');
const ux = projectsByCategory('ux-ui-webflow');
const all = [...threeD, ...ux];
const path = route('home', locale);

const jsonld = [
  {
    '@type': 'WebSite', '@id': `${SITE.url}/#website`, url: SITE.url, name: SITE.name,
    inLanguage: ['en', 'fr'], publisher: { '@id': `${SITE.url}/#person` },
  },
  {
    '@type': 'Person', '@id': `${SITE.url}/#person`, name: SITE.name, url: SITE.url,
    jobTitle: 'Freelance Web & 3D Designer', email: SITE.email,
    address: { '@type': 'PostalAddress', addressLocality: SITE.city, addressCountry: SITE.country },
    worksFor: { '@type': 'Organization', name: SITE.employer.name, url: SITE.employer.url },
    knowsAbout: ['Art direction', 'Web design', 'Webflow', '3D', 'Blender', 'Motion design', 'WebGL'],
    sameAs: [SITE.github],
  },
  {
    '@type': 'CollectionPage', '@id': `${new URL(path, SITE.url).href}#page`, url: new URL(path, SITE.url).href,
    name: m.title, description: m.description, inLanguage: locale, isPartOf: { '@id': `${SITE.url}/#website` },
    about: { '@id': `${SITE.url}/#person` },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: all.map((p, i) => ({
        '@type': 'ListItem', position: i + 1,
        url: new URL(workPath(p.slug, locale), SITE.url).href,
        name: `${p.name} ${p.secondName}`.trim(),
      })),
    },
  },
];
---

<Base locale={locale} title={m.title} description={m.description} path={path} alternates={{ en: '/', fr: '/fr' }} current="home" jsonld={jsonld} bodyClass="home">
  <section class="wrapper-hero">
    <h1 class="title-case text-center">{t.heroTitle}<span class="visually-hidden"> – {m.title}</span></h1>
    <div class="wrapper-hero-cate max-width-s" role="group" aria-label={locale === 'fr' ? 'Filtres' : 'Filters'}>
      <a href="#3d" class="txt-fill right filter-3d is-active" data-filter="3d">{t.filters.threeD}</a>
      <div class="separator type-hero" aria-hidden="true"></div>
      <a href="#ux" class="txt-fill filter-ux" data-filter="ux">{t.filters.ux}</a>
    </div>
  </section>

  <section id="3d" class="collection-immersive-3d" aria-label={t.filters.threeD} data-section="3d">
    <div class="wrapper-card-project" role="list">
      {threeD.map((p) => (
        <div role="listitem">
          <a href={workPath(p.slug, locale)} class="card-project" style={`background-color:${p.bgColor}`}>
            <Pic media={p.images.main} alt={`${p.name} ${p.secondName}`.trim()} class="main-image" sizes="(max-width: 479px) 40vw, 25vw" />
            <h2 class="title-case top-name">{p.name}</h2>
            <h2 class="title-case bot-name">{p.secondName}</h2>
          </a>
        </div>
      ))}
    </div>
  </section>

  <section id="ux" class="collection-ux-ui-webflow is-hidden" aria-label={t.filters.ux} data-section="ux">
    <div class="collection-list" role="list">
      {ux.map((p) => (
        <div role="listitem" class="collection-item-3">
          <a href={workPath(p.slug, locale)} class="wrapper-image-ux" aria-label={`${p.name} ${p.secondName}`.trim()}>
            <Pic media={p.images.main} alt="" class="image-case-ux" sizes="(max-width: 479px) 100vw, 50vw" />
          </a>
          <div class="sub-case">
            <a href={workPath(p.slug, locale)} class="link-block">
              <h2 class="project-name">{p.name}</h2>
              <h2 class="project-name">{p.secondName}</h2>
            </a>
            {p.link && <a href={p.link} target="_blank" rel="noopener" class="link-3"><span class="ul">{t.viewProject}</span></a>}
          </div>
        </div>
      ))}
    </div>
  </section>

  <script>
    import '../scripts/home';
  </script>
</Base>
