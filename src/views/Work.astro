---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import Video from '../components/Video.astro';
import { hasFrench, isThreeD, localized, plain, type Project } from '../lib/content';
import { meta, route, ui, workPath, type Locale } from '../lib/i18n';
import { SITE } from '../lib/site';
import { localImages } from '../lib/content';

interface Props { locale: Locale; project: Project }
const { locale, project: p } = Astro.props;
const t = ui[locale];
const name = `${p.name} ${p.secondName}`.trim();
const intro = localized(p, 'intro', locale).html;
const context = localized(p, 'context', locale).html;
const process = localized(p, 'process', locale).html;
const cats = localized(p, 'categoryHtml', locale).html;
const untranslated = locale === 'fr' && !hasFrench(p);
const path = workPath(p.slug, locale);
const url = new URL(path, SITE.url).href;
const description = plain(intro).slice(0, 158).replace(/\s+\S*$/, '') + '…';
const title = `${name} | ${SITE.name}`;
const img = p.images;
const alt = (n: number) => `${name} – ${locale === 'fr' ? 'visuel' : 'visual'} ${n}`;
const three = isThreeD(p);
const mainMeta = img.main ? localImages[img.main.file] : undefined;
const ogImage = img.main?.url ?? SITE.ogImage;

const jsonld = [
  {
    '@type': 'CreativeWork', '@id': `${url}#work`, url, name, description: plain(intro), inLanguage: locale,
    author: { '@id': `${SITE.url}/#person` }, creator: { '@id': `${SITE.url}/#person` },
    image: img.main?.url ?? undefined, genre: plain(cats), isPartOf: { '@id': `${SITE.url}/#website` },
    ...(p.link ? { sameAs: p.link } : {}),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.nav.projects, item: new URL(route('home', locale), SITE.url).href },
      { '@type': 'ListItem', position: 2, name, item: url },
    ],
  },
];

---

<Base
  locale={locale}
  title={title}
  description={description}
  path={path}
  alternates={{ en: workPath(p.slug, 'en'), fr: workPath(p.slug, 'fr') }}
  noindex={false}
  canonicalPath={untranslated ? workPath(p.slug, 'en') : undefined}
  ogImage={ogImage}
  ogType="article"
  jsonld={jsonld}
  bodyClass="work"
>
  {untranslated && <meta slot="head" name="robots" content="noindex, follow" />}

  <div class="horizontal-space" style={`background-color:${p.bgColor}`}>
    <h1 class="cms-title-case top-name cms">{p.name}</h1>
    <div class="cms-title-case bot-name">{p.secondName}</div>
  </div>
  <div class="wrapper-card-project absolute">
    <div class="card-project cms">
      <Pic media={img.main} alt={name} class={`case-image ${three ? '_3d' : 'ux'}`} loading="eager" fetchpriority="high" sizes="(max-width: 479px) 80vw, 60vw" />
    </div>
  </div>

  <div class="wrapper-cms-page">
    <div class="container-l gap-120px">
      <div class="wrapper-text-case">
        <div class="max-width-s cate">
          <div class="typo-heavy-10px full-caps">{t.labels.project}</div>
          {cats && <div class="wrapper-categorie"><div class="rich-text-block w-richtext" set:html={cats} /></div>}
        </div>
        <div class="vertical-gap-40px max-width-s">
          <div class="w-richtext" set:html={intro ?? ''} />
          {p.link && <a href={p.link} target="_blank" rel="noopener" class="link">{t.projectLink}</a>}
        </div>
      </div>
      {p.videos.landscape01 && <div class="image-full-cms"><Video media={p.videos.landscape01} variant="player" label={name} /></div>}
      {img.i01 && <div class="image-full-cms"><Pic media={img.i01} alt={alt(1)} class="para" sizes="(min-width: 1200px) 1152px, 100vw" /></div>}
    </div>

    {p.videos.mobile.length > 0 && (
      <div class="bg-image" style={`background-color:${p.bgColor}`}>
        <div class="double-image-mobile video-mobile">
          {p.videos.mobile.map((v, i) => (
            <div class={i === 0 ? 'image-mobile-01 max-width-xs' : 'max-width-xs'}><Video media={v} variant="loop" class="para" label={name} /></div>
          ))}
        </div>
      </div>
    )}

    {(img.left01 || img.right01 || context || p.videos.square.length > 0 || p.videos.landscape02 || img.i02) && (
      <div class="container-l gap-120px">
        {(img.left01 || img.right01) && (
          <div class="double-image-cms">
            <div class="container-double-image"><Pic media={img.left01} alt={alt(2)} class="image-grid-cms para" sizes="(max-width: 479px) 100vw, 576px" /></div>
            <div class="container-double-image"><Pic media={img.right01} alt={alt(3)} class="image-grid-cms para" sizes="(max-width: 479px) 100vw, 576px" /></div>
          </div>
        )}
        {context && (
          <div class="wrapper-text-case">
            <div class="max-width-s"><div class="typo-heavy-10px full-caps">{t.labels.context}</div></div>
            <div class="vertical-gap-40px max-width-s"><div class="w-richtext" set:html={context} /></div>
          </div>
        )}
        {p.videos.square.length > 0 && (
          <div class="double-image-cms">
            {p.videos.square.map((v) => <Video media={v} variant="loop" class="para" label={name} />)}
          </div>
        )}
        {p.videos.landscape02 && <div class="image-full-cms"><Video media={p.videos.landscape02} variant="loop" class="para" label={name} /></div>}
        {img.i02 && <div class="image-full-cms"><Pic media={img.i02} alt={alt(4)} class="para" sizes="(min-width: 1200px) 1152px, 100vw" /></div>}
      </div>
    )}

    {(img.mobile01 || img.mobile02) && (
      <div class="bg-image" style={`background-color:${p.bgColor};${img.bgMobile?.url ? `background-image:url(${img.bgMobile.url});` : ''}background-size:cover;background-position:50% 50%`}>
        <div class="double-image-mobile">
          <div class="image-mobile-01 max-width-xs"><Pic media={img.mobile01} alt={alt(5)} class="para" sizes="260px" /></div>
          <div class="max-width-xs"><Pic media={img.mobile02} alt={alt(6)} class="para" sizes="260px" /></div>
        </div>
      </div>
    )}

    {(process || img.i03) && (
      <div class="container-l gap-120px">
        {process && (
          <div class="wrapper-text-case">
            <div class="max-width-s"><div class="typo-heavy-10px full-caps">{t.labels.process}</div></div>
            <div class="vertical-gap-40px max-width-s"><div class="w-richtext" set:html={process} /></div>
          </div>
        )}
        {img.i03 && <div class="image-full-cms"><Pic media={img.i03} alt={alt(7)} class="para" sizes="(min-width: 1200px) 1152px, 100vw" /></div>}
      </div>
    )}

    {img.i04 && (
      <div class="bg-image" style={`background-color:${p.bgColor};${img.bgFull?.url ? `background-image:url(${img.bgFull.url});` : ''}background-size:cover;background-position:50% 50%`}>
        <div class="image-full-cms container-l"><Pic media={img.i04} alt={alt(8)} class="para" sizes="(min-width: 1200px) 1152px, 100vw" /></div>
      </div>
    )}

    {(img.i05 || img.left02 || img.right02 || img.left03 || img.right03 || p.videos.squareExtra.length > 0) && (
      <div class="container-l gap-120px">
        {img.i05 && <div class="image-full-cms"><Pic media={img.i05} alt={alt(10)} class="para" sizes="(min-width: 1200px) 1152px, 100vw" /></div>}
        {(img.left02 || img.right02) && (
          <div class="double-image-cms">
            <div class="container-double-image"><Pic media={img.left02} alt={alt(11)} class="image-grid-cms para" sizes="(max-width: 479px) 100vw, 576px" /></div>
            <div class="container-double-image"><Pic media={img.right02} alt={alt(12)} class="image-grid-cms para" sizes="(max-width: 479px) 100vw, 576px" /></div>
          </div>
        )}
        {(img.left03 || img.right03) && (
          <div class="double-image-cms">
            <div class="container-double-image"><Pic media={img.left03} alt={alt(13)} class="image-grid-cms para" sizes="(max-width: 479px) 100vw, 576px" /></div>
            <div class="container-double-image"><Pic media={img.right03} alt={alt(14)} class="image-grid-cms para" sizes="(max-width: 479px) 100vw, 576px" /></div>
          </div>
        )}
        {p.videos.squareExtra.length > 0 && (
          <div class="double-image-cms">
            {p.videos.squareExtra.map((v) => <Video media={v} variant="loop" class="para" label={name} />)}
          </div>
        )}
      </div>
    )}
  </div>

  <script is:inline type="module" src="https://cdn.jsdelivr.net/npm/@videojs/html@10.6.0/cdn/video-minimal.js"></script>
</Base>
