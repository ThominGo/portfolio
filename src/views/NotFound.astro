---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import { meta, route, ui, type Locale } from '../lib/i18n';
import { SITE } from '../lib/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const m = meta[locale].notFound;
const t = ui[locale];
---

<Base locale={locale} title={`${m.title} | ${SITE.name}`} description={m.description} path={locale === 'fr' ? '/fr/404' : '/404'} noindex showLegals={false} bodyClass="notfound">
  <div class="wrapper-about-page">
    <div class="wrapper-card-project no-absolute">
      <div class="card-project _404">
        <Pic media={SITE.notFoundImage} alt={locale === 'fr' ? 'Homme debout en t-shirt gris, pantalon sombre et chaussures beiges.' : 'Man standing wearing gray t-shirt, dark pants, and beige shoes with orange accents.'} class="main-image about" loading="eager" sizes="(max-width: 479px) 100vw, 750px" />
        <h1 class="title-case top-name">{t.notFound.top}</h1>
        <div class="title-case bot-name">{t.notFound.bot}</div>
      </div>
    </div>
  </div>
</Base>
