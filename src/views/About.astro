---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import { about, meta, route, ui, type Locale } from '../lib/i18n';
import { SITE } from '../lib/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const m = meta[locale].about;
const a = about[locale];
const path = route('about', locale);
const url = new URL(path, SITE.url).href;
const jsonld = [
  {
    '@type': 'ProfilePage', '@id': `${url}#page`, url, name: m.title, description: m.description, inLanguage: locale,
    isPartOf: { '@id': `${SITE.url}/#website` }, mainEntity: { '@id': `${SITE.url}/#person` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: ui[locale].nav.projects, item: new URL(route('home', locale), SITE.url).href },
      { '@type': 'ListItem', position: 2, name: ui[locale].nav.about, item: url },
    ],
  },
];
---

<Base locale={locale} title={m.title} description={m.description} path={path} alternates={{ en: route('about', 'en'), fr: route('about', 'fr') }} current="about" jsonld={jsonld} bodyClass="about">
  <div class="wrapper-about-page">
    <div class="wrapper-card-project no-absolute">
      <div class="card-project about">
        <Pic media={SITE.aboutImage} alt={a.image_alt} class="main-image about" loading="eager" fetchpriority="high" sizes="(max-width: 479px) 100vw, 750px" />
        <h1 class="title-case top-name">Thomas</h1>
        <div class="title-case bot-name" aria-hidden="true">Marilleau</div>
      </div>
    </div>
    <div class="container-m">
      <div class="vertical-gap-40px">
        {a.blocks.map((b) => (
          <div class="wrapper-about-type">
            <h2 class="typo-heavy-10px full-caps">{b.title}</h2>
            <div set:html={b.html} />
          </div>
        ))}
      </div>
    </div>
  </div>
  <script>
    import '../scripts/about';
  </script>
</Base>
