# Directus (local)
DIRECTUS_URL=http://localhost:8055
DIRECTUS_TOKEN=dev-static-token
DIRECTUS_SECRET=change-me-to-a-long-random-string
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=change-me

# Site
# Base publique des vidéos (R2 / CDN), sans slash final. Vide = fichiers locaux public/media/videos
PUBLIC_VIDEO_BASE=
# Google Tag Manager (laisser vide pour désactiver)
PUBLIC_GTM_ID=
# Simple Analytics sans cookie (true par défaut)
PUBLIC_SIMPLE_ANALYTICS=true
